<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="WritingTemplates">
 <sql id="columns">t.id,t.name,t.description,t.type_code,t.rich_content,t.content,t.revision,t.created_at,t.updated_at,COALESCE(u.display_name,'기본 템플릿') AS updater_name</sql>
 <select id="list" resultType="egovframework.backoffice.mvp.cms.WritingTemplateService$Stored">SELECT <include refid="columns"/> FROM writing_templates t LEFT JOIN users u ON t.updated_by=u.id ORDER BY t.id DESC</select>
 <select id="get" resultType="egovframework.backoffice.mvp.cms.WritingTemplateService$Stored">SELECT <include refid="columns"/> FROM writing_templates t LEFT JOIN users u ON t.updated_by=u.id WHERE t.id=#{value}</select>
 <insert id="create" useGeneratedKeys="true" keyProperty="id">INSERT INTO writing_templates(name,description,type_code,rich_content,content,created_by,updated_by) VALUES(#{name},#{description},'REVIEW',#{richContent},#{content},#{actorId},#{actorId})</insert>
 <update id="edit">UPDATE writing_templates SET name=#{name},description=#{description},rich_content=#{richContent},content=#{content},revision=revision+1,updated_by=#{actorId},updated_at=CURRENT_TIMESTAMP WHERE id=#{id}</update>
 <delete id="remove">DELETE FROM writing_templates WHERE id=#{value}</delete>
</mapper>
